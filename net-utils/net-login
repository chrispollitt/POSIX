#!/bin/sh
# the next line is a comment to Tcl but not to sh: it starts expect with "--", so options such as -v, -o and --help reach
# this script instead of being taken by expect itself \
exec expect -f "$0" -- ${1+"$@"}
# net-login: one script for the three ways to log in and be answered automatically.  What it does is decided by the NAME it
# is called by, so install it once and add symlinks (make install does):
#
#   ssh-mfa    HOST [ssh options] [command]   ssh; answers the host's "Token:" / "Verification code:" prompt with a fresh
#                                             one-time code (get_mfa_code.py HOST)
#   sudo-mfa   HOST [ssh options] [sudo args] runs  ssh -t HOST sudo ...  and answers sudo's prompt for the password from ~/.netrc
#                                             and its code prompt with get_mfa_code.py.  No sudo args: sudo -i (a root shell)
#   sudo-mfa   --local [sudo args]            the same for sudo on THIS machine (no ssh).  Also local: the name sudo-local, MFA_LOCAL=1,
#                                             or this machine's own name (or localhost) as the host:  sudo-mfa localhost systemctl ...
#                                             The password comes from the ~/.netrc line for this machine's name, the code from
#                                             get_mfa_code.py <this machine>.  Handy on cpbee itself, where `auth` is the vault.
#                                             Already root here: no prompts to answer, so it just runs the command (or sudo
#                                             with the same arguments if they start with an option) with no expect layer.
#   sudo-mfa --local on Windows (Cygwin)      there is no sudo: elevate with what Windows has.  Already administrator: run the
#                                             command (bash -c).  Otherwise the vault must give a code for this machine (nothing is
#                                             typed: a soft gate that needs the vault unlocked and a seed made by mfa-seed), then
#                                               terminal:  ssh localhost COMMAND         (the elevated shell, as the old sudo function did;
#                                                          any password or code prompt it shows is answered like in the other modes)
#                                               GUI:       RunAsAdminClient.exe COMMAND  (--gui, or the name sudo-gui)
#                                             Leading options (-i, -u ...) are dropped, as the old function did.  MFA_NO_CODE=1 skips the gate.
#
# Doing it for you, in every mode: the password comes from ~/.netrc, the one-time code from the vault (get_mfa_code.py).  When
# someone is at the terminal and something is missing it asks, and fixes it:
#   - the vault is locked        -> runs  ssh -t cpbee auth unlock  (you type the passphrase), then carries on
#   - no code seed for the host  -> offers to run  mfa-seed HOST USER  (makes the seed, shows it for a phone app)
#   - no ~/.netrc entry          -> asks for the password (not shown) and, once it has worked, offers to save it in ~/.netrc
#                                   (mode 600, old file kept in ~/BAK, 3 newest)
# MFA_NO_PROMPT=1 turns all of that off (cron, scripts): it then fails with a clear message instead.
#   telnet-netrc [HOST [PORT]]                telnet; answers "login:"/"Username:" and "Password:" from ~/.netrc
#
# Any name that starts with ssh-, sudo- or telnet- works.  A name that goes on with a label other than mfa or netrc is a
# shortcut taken from ~/.config/mfa/aliases ($MFA_ALIASES), so  ssh-wwl  is "ssh-mfa" to a fixed host.  Without a
# recognised name, give the mode first:  net-login ssh|sudo|telnet ...      net-login --help
#
# The aliases file, one line each, "#" starts a comment:     KEY  HOST  [USER  [READY-REGEX]]
#     wwl            whatwelove.org   whatwelo   Ready!       ssh-wwl and sudo-wwl; USER is whose code/sudo login it is
#     default-telnet cpvax                                      telnet-netrc with no host
#   READY-REGEX is what the host prints once you are logged in (ssh-mfa then hands over the terminal at once); the default
#   is a shell prompt ending in $ # % or >.
#
# How it behaves (ssh and sudo)
#   - A prompt for a code is answered whenever it appears, up to $MFA_TRIES times; a rejected code is retried with a fresh
#     one (if the new code equals the old one it waits for the next 30 s period).  A sudo prompt for the password is answered once
#     per round: if it comes again straight after, the password was wrong and it stops.
#   - It only waits $MFA_LOGIN_TIMEOUT s for a prompt or the ready text.  After that it stops watching for login failures,
#     so the output of a long remote command can never be mistaken for one, and it waits for the command to end with no
#     time limit.  A late code prompt is still answered.
#   - Login failures are ssh's and sudo's own messages (Permission denied, host key verification failed, connection
#     refused/timed out/reset, could not resolve host, sudo refusing: wrong password 3 times / not in the sudoers file).  They
#     end it with exit 1 and a clear line.  The remote command's exit status is passed on.
#   - Interactive or command is worked out from the arguments (the first word after the host that is not an ssh option or
#     an option's value starts the command); MFA_MODE=interactive|command overrides it.
#   - The code comes from get_mfa_code.py: the vault (auth totp) first, then a token file.  See its --help.
#   - Secrets never go on a command line or into the output.  ~/.netrc should be readable by you only (it warns if not).
#
# Environment (all optional; SSH_WWL_QUIET, _SSH, _USER, _LOGIN_TIMEOUT, _TRIES and _MODE from the old ssh-wwl still work)
#   MFA_SSH (ssh)  MFA_TELNET (telnet)   MFA_GETCODE (get_mfa_code.py)   MFA_NETRC (~/.netrc)   MFA_ALIASES
#   MFA_LOGIN_TIMEOUT (45)   MFA_TRIES (3)   MFA_GRACE (3; 5 for sudo)   MFA_QUIET (0; 1 hides the info lines)
#   MFA_MODE interactive|command   MFA_READY (regex)   MFA_USER (whose code, if not in the host or alias)
#   MFA_PASSWORD_PROMPT (regex for the sudo prompt that asks for the password)   MFA_TELNET_TIMEOUT (120)
#   MFA_SUDO (sudo; the local sudo to run)   MFA_LOCAL (1 = sudo mode runs sudo here, as --local)
#   MFA_UID (the user id to treat as "already root" if it is 0; default: id -u)   MFA_NO_PROMPT (1: never ask)   AUTH_HOST (cpbee)
#   Windows: MFA_PLATFORM (windows|unix, to override detection)   MFA_ADMIN_CMD (net session: succeeds when elevated)
#            MFA_RUNAS_CLIENT (/dos/RunAsAdminClient.exe)   MFA_NO_CODE (1: no code check)

proc env_or {names default} {
    foreach n $names {
        if {[info exists ::env($n)] && $::env($n) ne ""} { return $::env($n) }
    }
    return $default
}

set me          [file tail [info script]]
set ::env(MFA_NAME) $me
set quiet       [env_or {MFA_QUIET SSH_WWL_QUIET} 0]

proc info_line {msg} {
    global quiet me
    if {!$quiet} { send_user "$me: $msg\n" }
}

proc print_help {} {
    set fh [open [info script] r]
    set n 0
    while {[gets $fh line] >= 0} {
        incr n
        if {$n <= 4} continue                   ;# the shebang and the exec trick
        if {![string match "#*" $line]} break
        puts [string range $line 2 end]
    }
    close $fh
}

proc fail {msg {code 1}} {
    global me
    send_user "$me: $msg\n"
    exit $code
}

# ---- which mode, which alias ------------------------------------------------------------------------------------------
if {[lsearch -exact $argv --help] >= 0} { print_help; exit 0 }

set mode ""
set tag  ""
if {![regexp {^(ssh|sudo|telnet)(-(.*))?$} $me -> mode -> tag]} {
    set mode [lindex $argv 0]
    if {[lsearch -exact {ssh sudo telnet} $mode] < 0} {
        send_user "usage: net-login ssh|sudo|telnet ARGS...   (or call it as ssh-NAME, sudo-NAME, telnet-NAME)\n       net-login --help\n"
        exit 2
    }
    set argv [lrange $argv 1 end]
    set me "net-login $mode"
}
set local 0
set gui 0
if {$mode eq "sudo" && $tag eq "local"} { set local 1 }
if {$mode eq "sudo" && $tag eq "gui"} { set local 1; set gui 1 }
if {$mode eq "sudo" && [lindex $argv 0] eq "--local"} { set local 1; set argv [lrange $argv 1 end] }
if {$mode eq "sudo" && [lindex $argv 0] eq "--gui"} { set local 1; set gui 1; set argv [lrange $argv 1 end] }
if {$mode eq "sudo" && [env_or MFA_LOCAL 0] eq "1"} { set local 1 }
if {[lsearch -exact {mfa netrc login local gui} $tag] >= 0} { set tag "" }

set alias_host ""; set alias_user ""; set alias_ready ""
proc read_alias {key} {
    global alias_host alias_user alias_ready
    set f [env_or MFA_ALIASES ~/.config/mfa/aliases]
    if {[catch {open $f r} fh]} { return 0 }
    set found 0
    while {[gets $fh line] >= 0} {
        set line [string trim $line]
        if {$line eq "" || [string match "#*" $line]} continue
        set w [regexp -all -inline {\S+} $line]
        if {[lindex $w 0] eq $key && [llength $w] >= 2} {
            set alias_host [lindex $w 1]
            set alias_user [lindex $w 2]
            set alias_ready [join [lrange $w 3 end] " "]
            set found 1
            break
        }
    }
    close $fh
    return $found
}
if {$tag ne ""} {
    if {![read_alias $tag]} { fail "no shortcut \"$tag\" in [env_or MFA_ALIASES ~/.config/mfa/aliases] (lines: $tag HOST \[USER \[READY\]\])" 2 }
}

# where the code script lives: beside the real file this was started from (symlinks followed), else on PATH
proc real_path {p} {
    set p [file normalize $p]
    for {set i 0} {$i < 20} {incr i} {
        if {[catch {file readlink $p} l]} break
        if {[file pathtype $l] eq "relative"} { set l [file join [file dirname $p] $l] }
        set p [file normalize $l]
    }
    return $p
}
set real_dir [file dirname [real_path [info script]]]
set getcode [env_or MFA_GETCODE ""]
if {$getcode eq ""} {
    set side [file join $real_dir get_mfa_code.py]
    set getcode [expr {[file exists $side] ? $side : "get_mfa_code.py"}]
}

# a fresh code for HOST (and USER): the answer must end in six digits.  code_rc: why there was none (4 = the vault is locked, 1 = no seed)
set code_rc 0
proc get_code {host user} {
    global getcode code_rc
    set code_rc 0
    set cmd [list $getcode $host]
    if {$user ne ""} { lappend cmd $user }
    if {![catch {exec {*}$cmd 2>/dev/null} out]} {
        if {[regexp {(^|\n)\d{6}\s*$} $out]} { return [lindex [split [string trim $out] "\n"] end] }
        set code_rc 1
    } else {
        set code_rc [expr {[lindex $::errorCode 0] eq "CHILDSTATUS" ? [lindex $::errorCode 2] : 1}]
    }
    return ""
}

proc this_host {} {
    if {![catch {exec hostname -s} h] && $h ne ""} { return $h }
    return [lindex [split [info hostname] .] 0]
}

# is a person at the terminal who can be asked things?
proc can_prompt {} {
    if {[env_or MFA_NO_PROMPT 0] eq "1"} { return 0 }
    return [expr {![catch {exec tty -s <@stdin}]}]
}

# read one line from the terminal; hidden = no echo
proc ask {prompt {hidden 0}} {
    send_user $prompt
    flush stdout
    if {$hidden} { catch {exec stty -echo <@stdin} }
    set got [gets stdin line]
    if {$hidden} { catch {exec stty echo <@stdin}; send_user "\n" }
    if {$got < 0} { return "" }
    return [string trim $line "\r\n"]
}

proc unlock_vault {} {
    set h [env_or AUTH_HOST cpbee]
    send_user "[env_or MFA_NAME net-login]: the vault is locked; unlocking it now (type the vault passphrase)\n"
    if {[this_host] eq $h} { set cmd [list [env_or MFA_AUTH auth] unlock] } else { set cmd [list ssh -t $h auth unlock] }
    return [expr {![catch {exec {*}$cmd <@stdin >@stdout 2>@stderr}]}]
}

# the one-time code for HOST/USER from the vault.  If there is none and someone is at the terminal: unlock a locked vault, or
# offer to make the seed.  Returns "" when there is still none.
proc fetch_code {host user} {
    global code_rc real_dir
    set unlocked 0
    set offered 0
    while {1} {
        set c [get_code $host $user]
        if {$c ne ""} { return $c }
        if {![can_prompt]} { return "" }
        if {$code_rc == 4 && !$unlocked} {
            set unlocked 1
            if {[unlock_vault]} continue
            return ""
        }
        if {$code_rc == 1 && !$offered} {
            set offered 1
            set seedtool [file join $real_dir mfa-seed]
            if {![file exists $seedtool]} { set seedtool mfa-seed }
            set a [ask "There is no one-time-code seed for $host/$user.  Make one now with mfa-seed (you add it to a phone app)? \[Y/n\] "]
            if {[regexp {^[Nn]} $a]} { return "" }
            if {![catch {exec $seedtool $host $user <@stdin >@stdout 2>@stderr}]} continue
            return ""
        }
        return ""
    }
}

# the password for one of HOSTS (and USER): ~/.netrc, else ask (when someone is at the terminal) and remember to offer to save it
set save_pending {}
proc get_password {hosts user} {
    global save_pending
    foreach h $hosts {
        set cred [netrc_lookup $h $user]
        if {$cred eq ""} { set cred [netrc_lookup $h] }
        if {$cred ne ""} { return [lindex $cred 1] }
    }
    set h [lindex $hosts 0]
    if {![can_prompt]} { fail "no entry for $h in [env_or {MFA_NETRC NETRC} ~/.netrc] (machine $h login USER password SECRET)" } ;# allowlist secret
    send_user "[env_or MFA_NAME net-login]: ~/.netrc has no entry for $h.\n"
    set pw [ask "password for $user on $h (not shown): " 1]
    if {$pw eq ""} { fail "no password given" } ;# allowlist secret
    set save_pending [list $h $user $pw]
    return $pw
}

# once a password has worked: offer to keep it in ~/.netrc (backup first, 3 newest kept, mode 600)
proc offer_save_netrc {} {
    global save_pending
    if {$save_pending eq ""} return
    lassign $save_pending h u pw
    set save_pending {}
    set a [ask "Save it in ~/.netrc so it is answered from now on? \[Y/n\] "]
    if {[regexp {^[Nn]} $a]} { send_user "not saved (used for this run only)\n"; return }
    set f [file normalize [env_or {MFA_NETRC NETRC} ~/.netrc]]
    set stamp [clock format [clock seconds] -format %Y%m%d-%H%M%S]
    if {[file exists $f]} {
        set bakdir [file join [file dirname $f] BAK]
        file mkdir $bakdir
        set bak [file join $bakdir "[file tail $f].$stamp"]
        file copy -force $f $bak
        set olds [lsort -decreasing -command {apply {{a b} {expr {[file mtime $a] - [file mtime $b]}}}} [glob -nocomplain -directory $bakdir "[file tail $f].*"]]
        foreach old [lrange $olds 3 end] { file delete $old }
        send_user "backup of the old file: $bak\n"
    }
    set fh [open $f a]
    if {[file size $f] > 0} {
        set rd [open $f r]; seek $rd -1 end; set last [read $rd 1]; close $rd
        if {$last ne "\n"} { puts $fh "" }
    }
    regsub -all {[\\"]} $pw {\\&} esc
    puts $fh "machine $h login $u password \"$esc\"" ;# allowlist secret
    close $fh
    catch {exec chmod 600 $f}
    send_user "saved in $f\n"
}

proc give_up {msg} {
    global me
    send_user "\n$me: $msg\n"
    catch {close}
    catch {wait}
    exit 1
}

# the first word that is not an ssh option (or an option's value): where the host, or after it the command, starts
proc first_word_index {words} {
    set optargs {-B -b -c -D -E -e -F -I -i -J -L -l -m -O -o -p -Q -R -S -W -w}
    set i 0
    while {$i < [llength $words]} {
        set a [lindex $words $i]
        if {$a eq "--"} { return [expr {$i + 1 < [llength $words] ? $i + 1 : -1}] }
        if {[string match -* $a]} {
            if {[lsearch -exact $optargs $a] >= 0} { incr i }
            incr i
            continue
        }
        return $i
    }
    return -1
}

# ---- ~/.netrc ---------------------------------------------------------------------------------------------------------
# returns {login password} for HOST (exact, then the short name, then "default"); LOGIN, if given, picks among several
proc netrc_lookup {host {want_login ""}} {
    set f [env_or {MFA_NETRC NETRC} ~/.netrc]
    if {[catch {open $f r} fh]} { return {} }
    set text [read $fh]
    close $fh
    if {![catch {file attributes $f -permissions} perm] && ($perm & 0077) && $::tcl_platform(platform) eq "unix"} {
        info_line "warning: $f is readable by others (chmod 600 $f)"
    }
    # split into words ("double quoted" ones may hold spaces; \" and \\ escape); lines starting with # are comments; macdef runs to a blank line
    set toks {}
    set inmacdef 0
    foreach line [split $text "\n"] {
        set line [string trimright $line "\r"]
        if {$inmacdef} { if {[string trim $line] eq ""} { set inmacdef 0 }; continue }
        if {[regexp {^\s*#} $line]} continue
        set i 0; set n [string length $line]
        while {$i < $n} {
            set c [string index $line $i]
            if {[string is space $c]} { incr i; continue }
            if {$c eq "\""} {
                incr i; set w ""
                while {$i < $n && [string index $line $i] ne "\""} {
                    if {[string index $line $i] eq "\\" && $i + 1 < $n} { incr i }
                    append w [string index $line $i]; incr i
                }
                incr i
            } else {
                set j $i
                while {$j < $n && ![string is space [string index $line $j]]} { incr j }
                set w [string range $line $i [expr {$j - 1}]]
                set i $j
            }
            lappend toks $w
            if {$w eq "macdef"} { set inmacdef 1; break }
        }
    }
    # entries: machine X / default, then login, password, account words
    set entries {}
    set cur {}
    set k 0
    while {$k < [llength $toks]} {
        set t [lindex $toks $k]
        switch -- $t {
            machine { if {$cur ne ""} { lappend entries $cur }; set cur [list machine [lindex $toks [incr k]]] }
            default { if {$cur ne ""} { lappend entries $cur }; set cur [list machine *default*] }
            login - password - account { lappend cur $t [lindex $toks [incr k]] }
            macdef { incr k }
        }
        incr k
    }
    if {$cur ne ""} { lappend entries $cur }
    set short [lindex [split $host .] 0]
    foreach round {exact short default} {
        foreach e $entries {
            array unset d; array set d {login "" password ""}
            array set d $e
            set m $d(machine)
            switch -- $round {
                exact   { set hit [expr {$m eq $host}] }
                short   { set hit [expr {$m eq $short || [lindex [split $m .] 0] eq $short}] }
                default { set hit [expr {$m eq "*default*"}] }
            }
            if {!$hit} continue
            if {$want_login ne "" && $d(login) ne $want_login} continue
            return [list $d(login) $d(password)]
        }
    }
    return {}
}

# ---- telnet -----------------------------------------------------------------------------------------------------------
if {$mode eq "telnet"} {
    set telnet [env_or MFA_TELNET telnet]
    set ttimeout [env_or MFA_TELNET_TIMEOUT 120]
    set host $alias_host
    set port 23
    set words $argv
    if {$host eq ""} {
        if {[llength $words] > 0} {
            set host [lindex $words 0]; set words [lrange $words 1 end]
        } elseif {[read_alias default-telnet]} {
            set host $alias_host
        } else {
            send_user "usage: $me HOST \[PORT\]\n"; exit 2
        }
    }
    if {[llength $words] > 0} { set port [lindex $words 0] }
    set cred [netrc_lookup $host]
    if {$cred eq ""} {
        if {![can_prompt]} { fail "no entry for $host in [env_or {MFA_NETRC NETRC} ~/.netrc]" }
        send_user "$me: ~/.netrc has no entry for $host.\n"
        set tl [ask "login on $host: "]
        if {$tl eq ""} { fail "no login given" }
        set tp [ask "password for $tl on $host (not shown): " 1]
        if {$tp eq ""} { fail "no password given" } ;# allowlist secret
        set cred [list $tl $tp]
        set save_pending [list $host $tl $tp]
    }
    lassign $cred login pw
    if {$login eq ""} { fail "the ~/.netrc entry for $host has no login" }
    set timeout $ttimeout
    log_user 1                                 ;# show the connect/login dialogue as it happens (the password is not echoed)
    spawn -noecho $telnet $host $port
    set spawn_tty $spawn_out(slave,name)
    expect {
        -re {([Ll]ogin|[Uu]ser[Nn]ame|LOGIN|USERNAME):} { }
        timeout { fail "timed out after ${ttimeout}s waiting for the login prompt" }
        eof     { fail "connection closed by the remote host" }
    }
    send -- "$login\r"                         ;# CR, not LF: OpenVMS rejects a bare LF
    expect {
        -re {([Pp]assword|PASSWORD):} { }          ;# no (?i) here: expect's "gate keeper" would then match case-sensitively anyway
        timeout { fail "timed out after ${ttimeout}s waiting for the second prompt" }
        eof     { fail "connection closed by the remote host" }
    }
    send -- "$pw\r"
    set pw ""
    # let the post-login banner or prompt print before handing over; host specific (VMS, Linux, ...), so never fatal
    set timeout 5
    expect {
        -re {(?i)welcome|last (interactive )?login|[$#>] ?$|incorrect|failure|invalid} {
            if {![regexp -nocase {incorrect|failure|invalid} $expect_out(0,string)]} { offer_save_netrc }
        }
        timeout { offer_save_netrc }
        eof     { catch {wait}; exit 0 }
    }
    catch {
        trap {
            catch {
                set rows [stty rows]
                set cols [stty columns]
                stty rows $rows columns $cols < $spawn_tty
            }
        } WINCH
    }
    interact
    catch {wait} result
    exit [expr {[llength $result] >= 4 ? [lindex $result 3] : 0}]
}

# run a command with this process's terminal and exit with its status (no spawn: nothing to answer)
proc run_through {cmd} {
    global me
    if {[catch {exec {*}$cmd <@stdin >@stdout 2>@stderr} err]} {
        if {[lindex $::errorCode 0] eq "CHILDSTATUS"} { exit [lindex $::errorCode 2] }
        send_user "$me: $err\n"
        exit 127
    }
    exit 0
}

# does the sudo argument list contain a command to run (as opposed to only options such as -i or -u bob)?
proc sudo_is_command {words} {
    set valopts {-u -g -h -p -C -U -r -t -T -D -R}
    set i 0
    while {$i < [llength $words]} {
        set a [lindex $words $i]
        if {$a eq "--"} { return [expr {$i + 1 < [llength $words]}] }
        if {[string match -* $a]} {
            if {[lsearch -exact $valopts $a] >= 0} { incr i }
            incr i
            continue
        }
        return 1
    }
    return 0
}

# ---- ssh and sudo -----------------------------------------------------------------------------------------------------
set ssh           [env_or {MFA_SSH SSH_WWL_SSH} ssh]
set login_timeout [env_or {MFA_LOGIN_TIMEOUT SSH_WWL_LOGIN_TIMEOUT} 45]
set tries         [env_or {MFA_TRIES SSH_WWL_TRIES} 3]
set grace         [env_or MFA_GRACE [expr {$mode eq "sudo" ? 5 : 3}]]   ;# seconds to watch for a rejection after a code was sent
set ready         [env_or MFA_READY [expr {$alias_ready ne "" ? $alias_ready : {[$#%>] ?$}}]]
set pw_prompt     [env_or MFA_PASSWORD_PROMPT {\[sudo\] [Pp]assword for [^\r\n:]*: ?$}]

# split the arguments into: options, the host, the words after the host
set hidx [first_word_index $argv]
if {$mode eq "sudo" && !$local && $alias_host eq "" && $hidx >= 0} {
    # this machine's own name (or localhost) as the host means sudo here, without ssh
    set w [string trim [lindex $argv $hidx]]
    if {[lsearch -exact [list localhost 127.0.0.1 ::1 [this_host] [info hostname]] $w] >= 0} {
        set local 1
        set argv [lrange $argv [expr {$hidx + 1}] end]
    }
}
if {$local} {
    set hostspec [this_host]
    set pre {}
    set post $argv
} elseif {$alias_host ne ""} {
    set hostspec $alias_host
    if {$hidx < 0} { set pre $argv; set post {} } else { set pre [lrange $argv 0 [expr {$hidx - 1}]]; set post [lrange $argv $hidx end] }
} else {
    if {$hidx < 0} { send_user "usage: $me HOST \[ssh options\] \[[expr {$mode eq "sudo" ? "sudo args" : "command"}]\]\n"; exit 2 }
    set hostspec [lindex $argv $hidx]
    set pre  [lrange $argv 0 [expr {$hidx - 1}]]
    set post [lrange $argv [expr {$hidx + 1}] end]
}
# whose code, and which host name to ask the vault about
set host $hostspec
set user [env_or {MFA_USER SSH_WWL_USER} $alias_user]
if {$local && $user eq ""} { catch {exec id -un} user }
if {[regexp {^([^@]+)@(.+)$} $hostspec -> u h]} { set user $u; set host $h }
for {set i 0} {$i < [llength $pre]} {incr i} {
    if {[lindex $pre $i] eq "-l" && $i + 1 < [llength $pre]} { set user [lindex $pre [expr {$i + 1}]] }
}

# Windows (Cygwin): no sudo; elevate with ssh localhost (terminal) or RunAsAdminClient.exe (GUI), once the vault has given a code
set winssh 0
set platform [env_or MFA_PLATFORM [expr {[regexp {^(CYGWIN|MSYS|MINGW)} $::tcl_platform(os)] ? "windows" : "unix"}]]
if {$mode eq "sudo" && $local && $platform eq "windows"} {
    set words $post
    while {[llength $words] && [string match -* [lindex $words 0]]} { set words [lrange $words 1 end] }
    set admin [expr {![catch {exec {*}[env_or MFA_ADMIN_CMD {net session}] 2>@1}]}]
    if {$admin} {
        # already elevated: nothing to ask, just run it the way the old function did (eval)
        if {[llength $words]} { run_through [list bash -c [join $words " "]] } else { run_through [list bash -l] }
    }
    if {$gui && ![llength $words]} { send_user "usage: $me --gui COMMAND \[ARGS\]\n"; exit 2 }
    # the gate: the vault must give a code for this machine (unlocking it / offering mfa-seed if someone is here to ask)
    if {[env_or MFA_NO_CODE 0] ne "1"} {
        if {[fetch_code $host $user] eq ""} {
            fail "no one-time code available for $host/$user: the vault is locked or has no seed (mfa-seed $host $user; MFA_NO_CODE=1 skips this check)"
        }
    }
    if {$gui} {
        run_through [concat [env_or MFA_RUNAS_CLIENT /dos/RunAsAdminClient.exe] $words]
    }
    set winssh 1
}

# already root on this machine: nothing to answer, so run the command itself (no spawn, no netrc, no code)
if {$mode eq "sudo" && $local && !$winssh} {
    if {[catch {exec id -u} myuid]} { set myuid -1 }
    if {[env_or MFA_UID $myuid] eq "0"} {
        if {[llength $post] && ![string match -* [lindex $post 0]]} {
            set direct $post                                    ;# sudo-mfa --local systemctl status ssh
        } else {
            set direct [concat [env_or MFA_SUDO sudo] [expr {[llength $post] ? $post : {-i}}]]   ;# -i, -u bob ...: sudo needs no password for root
        }
        run_through $direct
    }
}

set sudo_pw ""
set pw_hosts [list $host]
if {$mode eq "sudo"} {
    set sudoargs [expr {[llength $post] ? $post : {-i}}]
    if {$winssh} {
        # Windows terminal elevation: ssh localhost COMMAND; its prompts (password, code), if any, are answered like the others
        set cmdline [concat $ssh localhost $words]
        set cmdmode [expr {[llength $words] > 0}]
        set pw_prompt [env_or MFA_PASSWORD_PROMPT {[Pp]assword[^\r\n:]*: ?$}]
        set pw_hosts [list localhost $host]
    } else {
        if {$local} {
            set cmdline [concat [env_or MFA_SUDO sudo] $sudoargs]
        } else {
            set cmdline [concat $ssh -t $pre [list $hostspec sudo] $sudoargs]
        }
        set cmdmode [sudo_is_command $post]
    }
    # sudo prompts for the login of the account on the host; the netrc entry is looked up by host (and that login).  A missing
    # entry is not an error yet: it is asked for if a password prompt actually comes.  allowlist secret
    foreach h $pw_hosts {
        set cred [netrc_lookup $h $user]
        if {$cred eq ""} { set cred [netrc_lookup $h] }
        if {$cred ne ""} { set sudo_pw [lindex $cred 1]; if {$user eq ""} { set user [lindex $cred 0] }; break }
    }
} else {
    set cmdline [concat $ssh $pre [list $hostspec] $post]
    set cmdmode [expr {[llength $post] > 0}]
}
switch -- [env_or {MFA_MODE SSH_WWL_MODE} auto] {
    interactive { set cmdmode 0 }
    command     { set cmdmode 1 }
}

log_user 1
spawn -noecho {*}$cmdline
set spawn_tty $spawn_out(slave,name)

set re_token {(?i)(token|verification code|one-time password|authenticator code)[^\r\n:]*: ?$}
set re_fail  {(?i)permission denied( \(|, please)|too many authentication failures|host key verification failed|connection (refused|timed out|reset by peer|closed by)|could not resolve hostname|no route to host|network is unreachable|incorrect password attempts?|is not in the sudoers file|may not run sudo|a terminal is required|a password is required} ;# allowlist secret
set re_bad   {(?i)(invalid token|token: error|invalid verification code)} ;# allowlist secret

set phase     login     ;# login: watch for failures; session: only the code prompts and the end
set otp_sent  0         ;# codes sent so far
set last_code ""
set last_sent ""        ;# what was sent last: pw or otp
set closed    0
set timeout   $login_timeout

# the next code to send: never the one already spent
proc next_code {} {
    global host user last_code
    set code [fetch_code $host $user]
    if {$code ne "" && $code eq $last_code} {
        # the same code again: it is spent; wait for the next 30 s period
        set wait_s [expr {30 - [clock seconds] % 30 + 1}]
        info_line "same code again, waiting ${wait_s}s for the next one"
        sleep $wait_s
        set code [get_code $host $user]
        if {$code eq $last_code} { set code "" }
    }
    return $code
}

expect {
    -re $re_token {
        if {$otp_sent >= $tries} { give_up "code rejected $otp_sent times, giving up" }
        set code [next_code]
        if {$code eq ""} { give_up "no new 6-digit code from $getcode (for $host)" }
        set last_code $code
        incr otp_sent
        set last_sent otp
        send -- "$code\r"
        if {$phase eq "login"} { set timeout $grace }
        exp_continue
    }
    -re $pw_prompt {
        if {$mode ne "sudo"} { exp_continue }
        if {$last_sent eq "pw"} { give_up "sudo password rejected" } ;# allowlist secret
        if {$sudo_pw eq ""} { set sudo_pw [get_password $pw_hosts $user] }
        set last_sent pw
        send -- "$sudo_pw\r"
        if {$phase eq "login"} { set timeout $grace }
        exp_continue
    }
    -re $re_fail {
        if {$phase eq "login"} {
            regsub {\s*[(,]\s*(please)?$} [string trim $expect_out(0,string)] {} why
            give_up "login failed (it said: $why)"
        }
        exp_continue
    }
    -re $re_bad {
        # the prompt comes again and is answered above; just keep watching
        exp_continue
    }
    -re $ready {
        # the remote shell is up (interactive); no more code to wait for.  In command mode keep going to the end.
        set phase session
    }
    timeout {
        # no prompt, no ready text: no code is needed, or the remote command is just slow.  Stop watching for failures.
        set phase session
        if {!$cmdmode && !$otp_sent && $last_sent eq ""} { info_line "no prompt within ${login_timeout}s; continuing without one" }
        if {$cmdmode} {
            set timeout -1
            exp_continue          ;# wait for the command to finish, answering a late code prompt if one comes
        }
    }
    eof {
        set closed 1
    }
}

# the login worked: if a password was asked for, offer to keep it
offer_save_netrc

# keep the remote terminal size in step with this window (only when there is a terminal)
catch {
    trap {
        catch {
            set rows [stty rows]
            set cols [stty columns]
            stty rows $rows columns $cols < $spawn_tty
        }
    } WINCH
}

if {!$closed} {
    if {$cmdmode} {
        set timeout -1
        expect {
            -re $re_token {
                if {$otp_sent >= $tries} { give_up "code rejected $otp_sent times, giving up" }
                set code [next_code]
                if {$code ne ""} { set last_code $code; incr otp_sent; send -- "$code\r" }
                exp_continue
            }
            eof
        }
    } else {
        interact
    }
}
catch {wait} result
exit [expr {[llength $result] >= 4 ? [lindex $result 3] : 0}]

#!/bin/bash
# git-credential-auth: a git credential helper backed by `auth get` (POSIX issue #6).
#
#   git config --global credential.helper auth          # git runs `git-credential-auth get`; this file must be on the PATH
#
# git sends key=value lines (protocol, host, username when it has one) on stdin to `get`; the answer is one username line
# and one line for the secret.  The record is  https@HOST LOGIN  (set with: auth set https@github.com YOURLOGIN, a token,
# not the account's own login word).  The service tier is read first, then the master tier; with the master vault locked and no service
# record there is no answer, git asks a person as usual.  `store` and `erase` do nothing: the vault is changed with
# `auth set` / `auth remove`, never by git.  Nothing is printed to the terminal; the secret is never on a command line.
export PATH="$PATH:/usr/local/bin:/usr/bin:/bin:$HOME/local/usr/bin"
AUTH=${AUTH_BIN:-auth}
[ "${1:-}" = get ] || exit 0
protocol=""; host=""; username=""
while IFS='=' read -r k v; do
  v=${v%$'\r'}
  case $k in protocol) protocol=$v ;; host) host=$v ;; username) username=$v ;; esac
done
[ -n "$protocol" ] && [ -n "$host" ] || exit 0
host=${host%%:*}                                             # the port is not part of the record
if [ -n "$username" ]; then
  pw=$("$AUTH" get "$protocol" "$host" "$username" </dev/null 2>/dev/null) || exit 0
  [ -n "$pw" ] || exit 0
  printf 'username=%s\npassword=%s\n' "$username" "$pw"
else
  out=$("$AUTH" get "$protocol" "$host" --with-login </dev/null 2>/dev/null) || exit 0
  [ -n "$out" ] || exit 0
  printf 'username=%s\npassword=%s\n' "${out%%$'\t'*}" "${out#*$'\t'}"
fi

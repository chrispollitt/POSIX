#!/bin/bash
# mfa-seed [HOST] [USER]: make a one-time-code seed, keep it in the vault, show it as a QR code for an authenticator app.
#
#   mfa-seed                     the LAN-wide seed for you: ONE entry in the phone app that works on every machine (HOST = lan)
#   mfa-seed lan alice           the same for another LAN user
#   mfa-seed cmlaptop            a seed for this login on one machine only (it overrides the LAN seed there)
#   REPLACE=1 mfa-seed ...       replace an existing seed (the app and anything else using the old one must be redone)
#
# The vault does the work (`auth seed`): it makes the random seed on the server, stores it in the master tier as 2fa@HOST USER
# (kind totp) and prints it once.  This script draws it as a QR code (qr-show; MFA_QR=sixel for a sixel terminal, MFA_QR=none to
# skip) and prints the seed and otpauth:// line for typing in, then asks you to type the code the app shows and checks it with
# `auth totp --verify`.  If the check fails 3 times a NEW record is removed again.  Codes come from `auth totp HOST USER`
# (get_mfa_code.py wraps it); a machine with no seed of its own uses the user's LAN one.  `sudo-mfa --local` on Windows offers to
# run this when there is no seed.  The seed is on your screen while this runs: clear it after.
set -u
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
AUTH=${MFA_AUTH:-auth}
if ! command -v "$AUTH" >/dev/null 2>&1 && [[ -x $here/auth ]]; then AUTH=$here/auth; fi
case ${1:-} in -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;; esac
host=${1:-lan}
user=${2:-$(id -un)}
die() { echo "mfa-seed: $*" >&2; exit 1; }
[[ -t 0 && -t 1 ]] || die "run this in a terminal"
"$AUTH" list >/dev/null 2>&1 || die "the vault is locked or unreachable: ssh -t cpbee auth unlock"

out=$("$AUTH" seed "$host" "$user" ${REPLACE:+--replace} --note "one-time code seed for $user on $host (mfa-seed)") || die "the vault would not make the seed (an existing one? REPLACE=1)"
seed=$(printf '%s\n' "$out" | sed -n 1p)
url=$(printf '%s\n' "$out" | sed -n 2p)
[[ -n $seed && -n $url ]] || die "unexpected answer from auth seed"

qr=$here/qr-show
[[ -x $qr ]] || qr=$(command -v qr-show || true)
echo
if [[ ${MFA_QR:-ansi} != none && -n $qr ]]; then
  echo "Scan this with your authenticator app (account \"$host $user\", time-based, 6 digits, 30 s):"
  echo
  "$qr" "$url" || echo "(could not draw the QR code; use the seed below)"
  echo
  echo "Or type it in:"
else
  echo "Add this to your authenticator app (account \"$host $user\", time-based, 6 digits, 30 s):"
fi
echo "    seed:     $seed"
echo "    otpauth:  $url"
unset seed url out
echo
n=0
while [[ $n -lt 3 ]]; do
  read -r -p "Type the code the app shows now: " code
  if "$AUTH" totp "$host" "$user" --verify "$code" >/dev/null 2>&1; then
    echo "ok: the app and the vault agree.  Clear this screen (the seed is above)."
    exit 0
  fi
  n=$((n+1)); echo "   not the same code ($n/3)"
done
if [[ -n ${REPLACE:-} ]]; then
  die "the code never matched; the NEW seed is stored in the vault anyway (REPLACE was set): redo the app or run again"
fi
"$AUTH" remove "2fa@$host" "$user" >/dev/null 2>&1
die "the code never matched; the new record was removed again (nothing is changed)"

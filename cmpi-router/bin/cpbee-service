#!/bin/bash
# cpbee-service - start, stop and restart a few of cpbee's services for the logged-in servers page.
# Installed as /usr/local/sbin/cpbee-service (root:root, 755) by `setup-services.sh servers-admin`; the web server's
# user (www-data) may run exactly this program through sudo (/etc/sudoers.d/cpbee-servers) and nothing else.
#
#   cpbee-service list                       name|state|allowed actions|label, one line per service
#   cpbee-service start|stop|restart NAME [BY]
#
# It is the only authority: PHP passes the words on, this decides.  A name or action that is not in the table below is
# refused; nothing from the caller reaches a shell.  BY (the logged-in user) is only for the log (journalctl -t cpbee-service).
# What is not here on purpose: apache2 and php-fpm (the page itself), ssh (a lock-out), mariadb and dnsmasq (the network and
# the other sites need them), networkd.
set -u
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

declare -A UNIT ACTS LABEL
def() { UNIT[$1]=$2; ACTS[$1]=$3; LABEL[$1]=$4; }
#   name       unit                 allowed actions          label
def floyd      tvchat-floyd.service "start stop restart"     "Floyd (chat bot)"
def ergo       ergo.service         "start stop restart"     "IRC server (Ergo)"
def talkd      talkd.service        "start stop restart"     "talkd (chat)"
def radicale   radicale.service     "start stop restart"     "Calendar server (Radicale)"
def dovecot    dovecot.service      "start restart"          "Mailbox server (Dovecot)"
def postfix    postfix.service      "start restart"          "Mail relay (Postfix)"
def traffic    trafficgraph.service "start stop restart"     "Traffic graphs"
def webmin     webmin.service       "start stop restart"     "Webmin"
def terminals  nginx.service        "restart"                "Terminal apps (nginx)"
def vax        vax.service          "start stop"             "VAX (cpvax)"

cmd=${1:-}; name=${2:-}; by=${3:-?}
by=$(printf '%s' "$by" | tr -cd 'A-Za-z0-9._@-' | cut -c1-40)

state() { systemctl is-active "${UNIT[$1]}" 2>/dev/null || true; }
fail()  { printf '%s\n' "$*"; exit 1; }

if [[ $cmd == list ]]; then
  for n in "${!UNIT[@]}"; do printf '%s|%s|%s|%s\n' "$n" "$(state "$n")" "${ACTS[$n]}" "${LABEL[$n]}"; done | sort
  exit 0
fi

[[ $cmd == start || $cmd == stop || $cmd == restart || $cmd == status ]] || fail "unknown action"
[[ $name =~ ^[a-z0-9]{1,20}$ && -n ${UNIT[$name]+x} ]] || fail "unknown service"
if [[ $cmd == status ]]; then state "$name"; exit 0; fi
[[ " ${ACTS[$name]} " == *" $cmd "* ]] || fail "$cmd is not allowed for ${LABEL[$name]}"

logger -t cpbee-service -p auth.notice "by=$by $cmd $name (${UNIT[$name]})"

# the VAX is VMS under a simulator: stopping the unit is a power cut, so a stop is an orderly shutdown, and it takes a few minutes
if [[ $name == vax && $cmd == stop ]]; then
  [[ $(state vax) == active ]] || fail "the VAX is not running"
  nohup vax-ctl shutdown >/dev/null 2>&1 &
  printf 'orderly shutdown of the VAX started (vax-ctl shutdown); it takes a few minutes\n'
  exit 0
fi

out=$(timeout 60 systemctl "$cmd" "${UNIT[$name]}" 2>&1)
rc=$?
st=$(state "$name")
if [[ $rc -ne 0 ]]; then
  fail "$cmd ${LABEL[$name]} failed (exit $rc): $(printf '%s' "$out" | tr '\n' ' ' | cut -c1-200)"
fi
printf '%s: %s -> now %s\n' "${LABEL[$name]}" "$cmd" "$st"

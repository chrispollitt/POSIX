#!/usr/bin/env python3
"""sasl-pass - print the password for LOGIN from a Postfix sasl_passwd file.

    sasl-pass [--file PATH] LOGIN

PATH defaults to /etc/postfix/sasl_passwd (lines "[host]:port  user:pass").
Used as getmail's password_command, so the mailbox password lives in the one
file configure-sendmail-relay.sh already wrote - same source pop-pull reads.
Exit 0 + password on stdout, or 2 + a message on stderr.
"""
import sys, argparse


def die(m):
    print("sasl-pass: " + m, file=sys.stderr)
    sys.exit(2)


def main():
    ap = argparse.ArgumentParser(prog="sasl-pass")
    ap.add_argument("--file", default="/etc/postfix/sasl_passwd")
    ap.add_argument("login")
    a = ap.parse_args()
    try:
        with open(a.file) as f:
            for ln in f:
                ln = ln.strip()
                if not ln or ln.startswith("#"):
                    continue
                fields = ln.split(None, 1)
                if len(fields) != 2:
                    continue
                user, sep, pw = fields[1].partition(":")
                if sep and user == a.login:
                    sys.stdout.write(pw + "\n")
                    return 0
    except OSError as e:
        die("cannot read %s: %s" % (a.file, e))
    die("no password for %s in %s" % (a.login, a.file))


if __name__ == "__main__":
    sys.exit(main())

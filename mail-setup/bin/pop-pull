#!/usr/bin/env python3
"""pop-pull - on-demand POP3S fetch into the local mailbox via sendmail.

Config: ~/.config/mailpull.conf (or --config FILE / $MAILPULL_CONF)
Password: read live from Postfix's own /etc/postfix/sasl_passwd (format
"[host]:port user:pass"), or pwfile= if set.
Seen-UID cache (keep mode): ~/.local/state/mailpull.seen (or seen= in the config)

Plus-address routing (optional): with  plus_base = cwp@u-l.ca  in the config,
one shared mailbox can serve several local users.  For each message the first
address in Delivered-To / X-Original-To / To / Cc that looks like
cwp+TAG@u-l.ca is taken; the message goes to local user TAG if the system
knows that account (getpwnam, uid >= plus_min_uid, default 1000), else to
local_user.  Run it as root or a service account to serve everyone.

This only works on hosts that deliver cwp+TAG@ mail INTO THE INBOX.  POP3 sees
nothing but the inbox, and cPanel-style hosts (Dovecot plus-addressing) file
cwp+TAG@ mail in an IMAP folder named TAG instead - there pop-pull never sees
tagged mail, so use  getmail --imap  (configure-getmail.sh --imap --plus-base
... --plus-users ...), which fetches the tag folders.  Check which kind of
host you have with tests/live/check-plus-addressing.py.
"""
import os, re, sys, ssl, socket, poplib, argparse, configparser, subprocess
import email.parser, email.utils
try:
    import pwd
except ImportError:                  # no account database (plain Windows)
    pwd = None

TOOL, VERSION = "pop-pull", "1.1.0"

CFG  = os.path.expanduser("~/.config/mailpull.conf")
SEEN = os.path.expanduser("~/.local/state/mailpull.seen")

# headers searched for the tagged address, most trustworthy first
PLUS_HEADERS = ("Delivered-To", "X-Original-To", "To", "Cc")
# a tag is untrusted mail-header text: only login-name-looking tags get through
TAG_RE = re.compile(r"^[a-z0-9_][a-z0-9._-]*$")

def _clean(s):
    """Header-safe ASCII: no controls, no folding."""
    return re.sub(r"[^\x21-\x7e]+", "_", str(s))[:200] or "unknown"

def trace_header(server, login):
    """The X-Pulled-By line pop-pull prepends to every message it delivers:
    who fetched it, where, and from which mailbox.  It is only ever ADDED -
    the message's own origin headers (Received, X-Mailer, X-Origin-*, ...)
    are passed through byte for byte, so the sender's origin survives."""
    try:
        import getpass
        me = getpass.getuser()
    except Exception:
        me = "unknown"
    return "X-Pulled-By: %s %s on %s (%s) from %s@%s" % (
        TOOL, VERSION, _clean(socket.gethostname()), _clean(me),
        _clean(login), _clean(server))

def stamp(raw, line):
    """RAW with LINE prepended, using RAW's own line-ending style."""
    eol = b"\r\n" if raw.split(b"\n", 1)[0].endswith(b"\r") else b"\n"
    return line.encode("ascii") + eol + raw

def die(m, code=2):
    print("pop-pull: " + m, file=sys.stderr); sys.exit(code)

def plus_tag(raw, base, sep="+"):
    """TAG of the first cwp+TAG@domain address in RAW's headers, else None."""
    want_local, _, want_dom = base.lower().rpartition("@")
    prefix = want_local + sep
    msg = email.parser.BytesHeaderParser().parsebytes(raw)
    for h in PLUS_HEADERS:
        for val in msg.get_all(h, []):
            for _, addr in email.utils.getaddresses([str(val)]):
                local, _, dom = addr.lower().rpartition("@")
                if dom == want_dom and local.startswith(prefix) and len(local) > len(prefix):
                    return local[len(prefix):]
    return None

def local_account(name, min_uid):
    if pwd is None:
        return False
    try:
        return pwd.getpwnam(name).pw_uid >= min_uid
    except KeyError:
        return False

def route(raw, default, base, sep="+", min_uid=1000):
    """local user to deliver RAW to: the tagged account if there is one."""
    if not base:
        return default
    tag = plus_tag(raw, base, sep)
    if tag and TAG_RE.match(tag) and local_account(tag, min_uid):
        return tag
    return default

def password(pwfile, login):
    # Postfix sasl_passwd lines look like:  [host]:port  user:pass
    try:
        with open(pwfile) as f:
            for ln in f:
                ln = ln.strip()
                if not ln or ln.startswith("#"):
                    continue
                fields = ln.split(None, 1)
                if len(fields) != 2:
                    continue
                user, sep, pw = fields[1].partition(":")
                if sep and user == login:
                    return pw
    except OSError as e:
        die("cannot read %s: %s" % (pwfile, e))
    die("no password for %s in %s" % (login, pwfile))

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("-V", "--version", action="version",
                    version="%s %s" % (TOOL, VERSION))
    ap.add_argument("-v", "--verbose", action="store_true")
    ap.add_argument("-n", "--dry-run", action="store_true")
    ap.add_argument("-c", "--config", default=os.environ.get("MAILPULL_CONF") or CFG,
                    help="config file (default %s)" % CFG)
    a = ap.parse_args()

    c = configparser.ConfigParser()
    if not c.read(a.config):
        die("missing config %s (run mail-setup.sh or scripts/configure-mail-pull.sh)" % a.config)
    s = c["mailpull"]
    server, login = s["server"], s["user"]
    port = s.getint("port", 995)
    local_user = s["local_user"]
    plus_base = s.get("plus_base", "").strip()
    plus_sep = s.get("plus_sep", "+").strip() or "+"
    plus_min_uid = s.getint("plus_min_uid", 1000)
    seen_file = os.path.expanduser(s.get("seen", "").strip()) or SEEN
    if plus_base and (plus_base.count("@") != 1 or plus_sep in plus_base.split("@")[0]):
        die("plus_base must be a plain address like cwp@u-l.ca, not %r" % plus_base)
    keep = s.getboolean("keep", True)
    verify = s.getboolean("verify", True)
    cafile = s.get("cafile", "").strip()
    mda = s.get("mda", "/usr/sbin/sendmail")
    pw = password(s.get("pwfile", "/etc/postfix/sasl_passwd"), login)

    ctx = ssl.create_default_context()
    if cafile and os.path.exists(cafile):
        ctx.load_verify_locations(cafile)
    if not verify:
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE

    seen = set()
    if keep and os.path.exists(seen_file):
        with open(seen_file) as f:
            seen = set(f.read().split())

    try:
        M = poplib.POP3_SSL(server, port, context=ctx, timeout=45)
    except Exception as e:
        die("connect %s:%d failed: %s" % (server, port, e))
    try:
        M.user(login); M.pass_(pw)
        n = M.stat()[0]
        uidl = {}
        for line in M.uidl()[1]:
            i, u = line.decode().split(None, 1)
            uidl[int(i)] = u
        got = 0; new = set(seen); per_user = {}
        for i in range(1, n + 1):
            u = uidl.get(i, str(i))
            if keep and u in seen:
                continue
            raw = b"\r\n".join(M.retr(i)[1]) + b"\r\n"
            to = route(raw, local_user, plus_base, plus_sep, plus_min_uid)
            dest = " -> " + to if plus_base else ""
            if a.dry_run:
                if a.verbose:
                    print("[dry-run] msg %d uid %s (%d bytes)%s" % (i, u, len(raw), dest))
            else:
                r = subprocess.run([mda, "-oi", "--", to],
                                   input=stamp(raw, trace_header(server, login)))
                if r.returncode != 0:
                    print("pop-pull: delivery failed on msg %d" % i, file=sys.stderr)
                    break
                if a.verbose:
                    print("delivered msg %d uid %s (%d bytes)%s" % (i, u, len(raw), dest))
            per_user[to] = per_user.get(to, 0) + 1
            got += 1
            if keep:
                new.add(u)
            elif not a.dry_run:
                M.dele(i)
        if keep and not a.dry_run:
            os.makedirs(os.path.dirname(seen_file), exist_ok=True)
            with open(seen_file, "w") as f:
                f.write("\n".join(sorted(new)) + "\n")
        M.quit()
    except Exception as e:
        try: M.quit()
        except Exception: pass
        die(str(e))

    if got:
        if plus_base:
            where = ", ".join("/var/mail/%s (%d)" % kv for kv in sorted(per_user.items()))
        else:
            where = "/var/mail/" + local_user
        print("pop-pull: %d new message(s) %s %s"
              % (got, "would go to" if a.dry_run else "->", where))
        sys.exit(0)
    print("pop-pull: no new mail")
    sys.exit(1)

if __name__ == "__main__":
    main()

#!/usr/bin/env python3
"""list-import - turn old mailing-list material into list mail and put it in members' folders (lists-setup).

    list-import --list NAME [options] SOURCE...  [-- CMD ARG...]

A SOURCE is a text file, or ZIPFILE::MEMBER for a file inside a zip.  Three shapes of old material are understood
(--format, default auto):

    arpa       one file of messages one after another, each starting with its own Date: / From: / Subject: header
               lines (the 1979 SF-Lovers archive: a blank line or a line of dashes between messages)
    babyl      an Emacs rmail (Babyl) file: one record per mail, each is one message here - the digest issues of
               SF-Lovers volumes 13 and 25.  The part after "*** EOOH ***" is the message's own header
    sections   one long document, cut into one message per numbered section (1.1. Title ...), as the Cyphernomicon;
               needs --date; the subject is "--title N.N Title"

Each message is made into what mlmmj would have delivered to a member of the list NAME: a clean header block (From
made into an address, Date into RFC 5322 - the old forms "15 SEP 1979 2216-PDT", "6 Jan 88 0837-EST" and "18 Sep 1979
9:25 am" are read - a Message-ID, In-Reply-To kept only if it is a real one), `List-Id: <NAME.DOMAIN>` (what the
server's Sieve rule files by), `To: NAME@DOMAIN`, the subject prefix `[NAME]`, X-Archive-Source naming the file,
and the text as UTF-8.  Nothing is invented but the addresses of senders that had none (NAME@HOST.invalid).

Where the messages go (the last of these given wins):
    --dry-run            read, convert, count, print nothing else
    --out FILE.mbox      write an mbox
    -- CMD ARG...        run CMD once per message with the message on its standard input, e.g.
                         -- /usr/lib/dovecot/dovecot-lda -d chris
                         (the server's Sieve then files it into Lists/NAME)

Options
    --domain D           list addresses are NAME@D (default: DOMAIN of lists.conf)
    --conf FILE          lists.conf (default /etc/lists-setup/lists.conf; only DOMAIN is read)
    --format F           arpa, babyl, sections or auto
    --date YYYY-MM-DD    sections: the date of the document (each section is a minute later than the one before)
    --title TEXT         sections: the subject prefix (default: the file's name)
    --no-prefix          do not put [NAME] in front of the subject
    --state FILE         remember the Message-IDs delivered; a re-run skips them (with -- CMD, and --out)
    --limit N            stop after N messages
    -v                   say what is skipped

Exit status 0 when every message was delivered or written; 1 when a delivery failed (the state file has what went in);
2 for a bad command line.
"""
import argparse
import datetime
import email.header
import email.utils
import hashlib
import os
import re
import subprocess
import sys
import zipfile

_here = os.path.dirname(os.path.realpath(__file__))
for _p in (_here, "/usr/local/lib/lists-setup"):
    if _p not in sys.path:
        sys.path.insert(0, _p)

MONTHS = {m: i for i, m in enumerate(("jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"), 1)}
ZONES = {"est": -5, "edt": -4, "cst": -6, "cdt": -5, "mst": -7, "mdt": -6, "pst": -8, "pdt": -7, "gmt": 0, "ut": 0, "utc": 0,
         "z": 0}
DATE_RE = re.compile(
    r"(\d{1,2})\s+([A-Za-z]{3})[A-Za-z]*\.?,?\s+(\d{2,4})"                    # 15 SEP 1979 / 6 Jan 88
    r"(?:\s+(\d{1,2}):?(\d{2})(?::(\d{2}))?\s*([AaPp][Mm])?"                   # 2216 / 9:25 am / 10:00:10
    r"(?:\s*\(?\s*([+-]\d{4})|\s*-?\s*\(?([A-Za-z]{2,4}))?)?")                 # -0500 / -PDT / EST
MSGID_RE = re.compile(r"^<[^<>\s@\[\]]+@[^<>\s@\[\]]+>$")


class ImportError_(Exception):
    pass


# ---------------------------------------------------------------------------------------------------- dates ---
def parse_date(text):
    """A datetime (aware) for the odd date forms of old mailing lists, or None."""
    for m in DATE_RE.finditer(text or ""):
        day, mon, year, hh, mm, ss, ampm, numzone, namezone = m.groups()
        mon = MONTHS.get(mon.lower())
        if not mon:
            continue
        year = int(year)
        if year < 100:
            year += 1900 if year >= 70 else 2000
        if not 1960 <= year <= 2100:
            continue
        hour, minute, sec = int(hh or 0), int(mm or 0), int(ss or 0)
        if ampm:
            hour = hour % 12 + (12 if ampm.lower() == "pm" else 0)
        if numzone:
            off = int(numzone[1:3]) * 60 + int(numzone[3:5])
            off = -off if numzone[0] == "-" else off
        else:
            off = int(ZONES.get((namezone or "").lower(), 0) * 60)
        try:
            tz = datetime.timezone(datetime.timedelta(minutes=off))
            return datetime.datetime(year, mon, int(day), hour, minute, sec, tzinfo=tz)
        except ValueError:
            continue
    return None


# -------------------------------------------------------------------------------------------------- headers ---
def parse_headers(block):
    """[(Name, value)] of a header block, continuation lines folded in."""
    out = []
    for line in block.split("\n"):
        if line[:1] in (" ", "\t") and out:
            out[-1][1] += " " + line.strip()
        elif re.match(r"^[A-Za-z][A-Za-z0-9-]*:", line):
            k, v = line.split(":", 1)
            out.append([k, v.strip()])
    return [(k, v) for k, v in out]


def header(hdrs, name):
    name = name.lower()
    for k, v in hdrs:
        if k.lower() == name:
            return v
    return ""


def make_address(raw, domain_hint="archive"):
    """(name, address) for From: values such as `LSTEWART at PARC-MAXC`, `PDL at MIT-DMS (P. David Lebling)`,
    `Saul Jaffe (The Moderator) <x@y>`, or a plain address.  An address that is no address becomes NAME@HOST.invalid."""
    raw = " ".join((raw or "").split())
    m = re.match(r"^(.*?)\s*<\s*([^<>@]+?)\s+at\s+([^\s<>]+)\s*>$", raw, re.I)            # Name <user at HOST>
    if m:
        who, local, host = m.groups()
        local = ".".join(w for w in (re.sub(r"[^A-Za-z0-9_.-]", "", w) for w in local.split()) if w) or "unknown"
        return who.strip().strip('"') or local, "%s@%s.invalid" % (local, host)
    name, addr = email.utils.parseaddr(raw)
    if addr and "@" in addr and re.match(r"^[^\s@<>]+@[^\s@<>]+$", addr):
        return name, addr
    m = re.match(r"^(.+?)\s+at\s+([^\s()<>]+)\s*(?:\((.*)\))?$", raw, re.I)
    if m:
        who, host, paren = m.groups()
        words = [re.sub(r"[^A-Za-z0-9_-]", "", w) for w in who.replace(",", " ").split()]
        local = ".".join(w for w in words if w) or "unknown"
        return (paren or who).strip(), "%s@%s.invalid" % (local, host)
    word = re.sub(r"[^A-Za-z0-9._-]", "", raw.split(" ")[0] if raw else "") or "unknown"
    return raw or word, "%s@%s.invalid" % (word, domain_hint)


def enc_header(text):
    text = " ".join(text.split())
    try:
        text.encode("ascii")
        return text
    except UnicodeEncodeError:
        return email.header.Header(text, "utf-8").encode()


# ---------------------------------------------------------------------------------------------------- splitters ---
def _headers_and_body(chunk):
    """Split `headers, blank line, body` where the headers are the leading lines that look like headers."""
    lines = chunk.split("\n")
    i = 0
    while i < len(lines) and (re.match(r"^[A-Za-z][A-Za-z0-9-]*:", lines[i]) or (lines[i][:1] in (" ", "\t") and i)):
        i += 1
    return parse_headers("\n".join(lines[:i])), "\n".join(lines[i:]).lstrip("\n")


def split_arpa(text):
    """Messages of an ARPANET-style archive: a message starts at a `Date:` line whose next lines have `From:`, after
    a blank line or a line of dashes.  [(headers, body)]."""
    text = text.replace("\r\n", "\n")
    lines = text.split("\n")
    starts = []
    for i, ln in enumerate(lines):
        if not ln.startswith("Date:"):
            continue
        if i > 0 and lines[i - 1].strip() and not re.fullmatch(r"-{3,}", lines[i - 1].strip()):
            continue
        if any(l.startswith("From:") for l in lines[i + 1:i + 4]):
            starts.append(i)
    out = []
    for n, s in enumerate(starts):
        e = starts[n + 1] if n + 1 < len(starts) else len(lines)
        hdrs, body = _headers_and_body("\n".join(lines[s:e]))
        out.append((hdrs, body))
    return out


def split_babyl(text):
    """Records of an rmail file: [(headers, body)] using the header block after `*** EOOH ***` (the mail's own),
    with Message-Id taken from the transport headers before it when the mail's own has none."""
    text = text.replace("\r\n", "\n")
    out = []
    for rec in text.split("\x1f\x0c")[1:]:
        rec = rec.split("\x1f", 1)[0].replace("\x0c", "")
        rec = rec.split("\n", 1)[1] if "\n" in rec else rec              # the "1, edited,," attributes line
        if "*** EOOH ***" in rec:
            pre, post = rec.split("*** EOOH ***", 1)
            hdrs, body = _headers_and_body(post.lstrip("\n"))
            if not header(hdrs, "message-id"):
                mid = header(parse_headers(pre), "message-id")
                if mid:
                    hdrs.append(("Message-ID", mid))
        else:
            hdrs, body = _headers_and_body(rec.lstrip("\n"))
        if hdrs:
            out.append((hdrs, body))
    return out


SECTION = re.compile(r"(?m)^(\d{1,2}\.\d{1,2})\.\s+(.+?)\s*$")


def split_sections(text):
    """[(number, title, text)] for the second-level headings `1.2. Foreword`; whatever comes before the first one,
    and the top-level headings (`2. MFAQ`), stay with the section that follows."""
    text = text.replace("\r\n", "\n")
    marks = list(SECTION.finditer(text))
    out = []
    for n, m in enumerate(marks):
        start = 0 if n == 0 else m.start()
        # a top-level heading right before this one belongs to it
        if n:
            before = text[marks[n - 1].end():m.start()]
            top = list(re.finditer(r"(?m)^\d{1,2}\.\s+\S.*$", before))
            if top:
                start = marks[n - 1].end() + top[-1].start()
        end = marks[n + 1].start() if n + 1 < len(marks) else len(text)
        if n + 1 < len(marks):
            nxt = text[m.end():marks[n + 1].start()]
            top = list(re.finditer(r"(?m)^\d{1,2}\.\s+\S.*$", nxt))
            if top:
                end = m.end() + top[-1].start()
        out.append((m.group(1), m.group(2), text[start:end].strip("\n")))
    return out


def detect_format(text):
    if "\x1f\x0c" in text[:5000] or text.startswith("BABYL OPTIONS"):
        return "babyl"
    if len(re.findall(r"(?m)^Date: .*\n(?:.*\n){0,2}?From: ", text)) >= 3:
        return "arpa"
    return "sections"


# ----------------------------------------------------------------------------------------------- building ---
def clean_body(body):
    body = body.replace("\x0c", "").replace("\x1f", "")
    lines = [ln.rstrip() for ln in body.split("\n")]
    while lines and (not lines[-1].strip() or re.fullmatch(r"-{3,}", lines[-1].strip())):     # the dashes that ended it
        lines.pop()
    return "\n".join(lines).strip("\n") + "\n"


def build(listname, domain, hdrs, body, when, source, prefix=True, subject=None):
    """(message bytes, Message-ID, datetime) for one converted message."""
    body = clean_body(body)
    subject = subject or header(hdrs, "subject") or "(no subject)"
    if prefix and not subject.lower().startswith("[%s]" % listname):
        subject = "[%s] %s" % (listname, subject)
    name, addr = make_address(header(hdrs, "from") or header(hdrs, "sender"))
    d = when or parse_date(header(hdrs, "date")) or datetime.datetime(1980, 1, 1, tzinfo=datetime.timezone.utc)
    mid = header(hdrs, "message-id")
    if not MSGID_RE.match(mid or ""):
        h = hashlib.sha1(("%s\n%s\n%s" % (source, subject, body)).encode("utf-8", "replace")).hexdigest()[:24]
        mid = "<%s@%s>" % (h, "archive.invalid")
    irt = header(hdrs, "in-reply-to")
    m = re.search(r"<[^<>\s@\[\]]+@[^<>\s@\[\]]+>", irt)
    head = ["From: %s" % email.utils.formataddr((enc_header(name) if name else "", addr)) if name else "From: %s" % addr,
            "To: %s@%s" % (listname, domain),
            "Date: %s" % email.utils.format_datetime(d),
            "Subject: %s" % enc_header(subject),
            "Message-ID: %s" % mid]
    if m:
        head.append("In-Reply-To: %s" % m.group(0))
    head += ["List-Id: <%s.%s>" % (listname, domain),
             "X-Archive-Source: %s" % enc_header(source),
             "MIME-Version: 1.0", "Content-Type: text/plain; charset=utf-8", "Content-Transfer-Encoding: 8bit"]
    return ("\n".join(head) + "\n\n" + body).encode("utf-8"), mid, d


def read_source(spec):
    """(text, label) of FILE or ZIP::MEMBER; text decoded as UTF-8, else Latin-1."""
    if "::" in spec:
        zpath, member = spec.split("::", 1)
        with zipfile.ZipFile(zpath) as z:
            raw = z.read(member)
        label = "%s:%s" % (os.path.basename(zpath), member)
    else:
        with open(spec, "rb") as fh:
            raw = fh.read()
        label = os.path.basename(spec)
    try:
        return raw.decode("utf-8"), label
    except UnicodeDecodeError:
        return raw.decode("latin-1"), label


def convert(listname, domain, spec, fmt="auto", date=None, title=None, prefix=True):
    """[(bytes, message-id, datetime)] for one source, oldest first."""
    text, label = read_source(spec)
    fmt = detect_format(text) if fmt == "auto" else fmt
    out = []
    if fmt in ("arpa", "babyl"):
        recs = split_arpa(text) if fmt == "arpa" else split_babyl(text)
        last = None
        for i, (hdrs, body) in enumerate(recs):
            when = parse_date(header(hdrs, "date"))
            if when is None and last is not None:
                when = last + datetime.timedelta(minutes=1)                   # unreadable date: just after the one before
            last = when or last
            out.append(build(listname, domain, hdrs, body, when, "%s#%d" % (label, i + 1), prefix))
    elif fmt == "sections":
        if not date:
            raise ImportError_("--format sections needs --date YYYY-MM-DD")
        base = datetime.datetime.strptime(date, "%Y-%m-%d").replace(hour=12, tzinfo=datetime.timezone.utc)
        for i, (num, ttl, body) in enumerate(split_sections(text)):
            subj = "%s %s %s" % (title or os.path.splitext(os.path.basename(label.split(":")[-1]))[0], num, ttl)
            hdrs = [("From", "%s <%s@%s>" % (title or "Archive", listname, domain))]
            out.append(build(listname, domain, hdrs, body, base + datetime.timedelta(minutes=i),
                             "%s#%s" % (label, num), prefix, subject=subj))
    else:
        raise ImportError_("--format: arpa, babyl, sections or auto")
    out.sort(key=lambda r: r[2])
    return out


def mbox_entry(raw, when):
    body = raw.decode("utf-8", "replace")
    body = re.sub(r"(?m)^(>*From )", r">\1", body)
    return ("From archive %s\n" % when.strftime("%a %b %d %H:%M:%S %Y")).encode("ascii") + body.encode("utf-8") + b"\n"


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    cmd = []
    if "--" in argv:
        i = argv.index("--")
        argv, cmd = argv[:i], argv[i + 1:]
    ap = argparse.ArgumentParser(prog="list-import", description="old mailing-list material -> list mail")
    ap.add_argument("sources", nargs="+", metavar="SOURCE")
    ap.add_argument("--list", required=True, dest="listname")
    ap.add_argument("--domain")
    ap.add_argument("--conf")
    ap.add_argument("--format", default="auto", choices=("auto", "arpa", "babyl", "sections"))
    ap.add_argument("--date")
    ap.add_argument("--title")
    ap.add_argument("--no-prefix", action="store_true")
    ap.add_argument("--state")
    ap.add_argument("--limit", type=int, default=0)
    ap.add_argument("--out")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("-v", "--verbose", action="store_true")
    a = ap.parse_args(argv)
    domain = a.domain
    if not domain:
        try:
            import listlib
            domain = listlib.load_config(a.conf)["DOMAIN"]
        except Exception as e:
            sys.stderr.write("list-import: no --domain and no usable lists.conf (%s)\n" % e)
            return 2
    if not re.match(r"^[a-z0-9][a-z0-9._-]*$", a.listname):
        sys.stderr.write("list-import: '%s' is not a list name\n" % a.listname)
        return 2
    if not (a.dry_run or a.out or cmd):
        sys.stderr.write("list-import: say where the messages go: --dry-run, --out FILE or -- CMD ARG...\n")
        return 2
    done = set()
    if a.state and os.path.exists(a.state):
        with open(a.state, encoding="utf-8") as fh:
            done = set(fh.read().split())
    msgs = []
    try:
        for spec in a.sources:
            msgs += convert(a.listname, domain, spec, a.format, a.date, a.title, not a.no_prefix)
    except (ImportError_, OSError, zipfile.BadZipFile, KeyError) as e:
        sys.stderr.write("list-import: %s\n" % e)
        return 2
    msgs.sort(key=lambda r: r[2])
    sent = skipped = failed = 0
    state = open(a.state, "a", encoding="utf-8") if a.state and not a.dry_run else None
    outf = open(a.out, "ab") if a.out and not a.dry_run else None
    try:
        for raw, mid, when in msgs:
            if mid in done:
                skipped += 1
                continue
            if a.limit and sent >= a.limit:
                break
            if not a.dry_run:
                if outf:
                    outf.write(mbox_entry(raw, when))
                elif cmd:
                    p = subprocess.run(cmd, input=raw, capture_output=True)
                    if p.returncode != 0:
                        failed += 1
                        sys.stderr.write("list-import: delivery of %s failed (%s): %s\n" % (
                            mid, p.returncode, (p.stderr or b"").decode("utf-8", "replace").strip()[-300:]))
                        break
                if state:
                    state.write(mid + "\n")
                    state.flush()
            sent += 1
    finally:
        if state:
            state.close()
        if outf:
            outf.close()
    what = "would deliver" if a.dry_run else "wrote" if a.out else "delivered"
    sys.stdout.write("%s: read %d, %s %d, already done %d%s\n" % (
        a.listname, len(msgs), what, sent, skipped, ", FAILED %d" % failed if failed else ""))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
